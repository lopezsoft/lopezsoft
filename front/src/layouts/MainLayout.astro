---
// ==========================================================================
// LOPEZSOFT SAS — Layout Principal
// ==========================================================================
import "@styles/global.scss";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import SEOHead from "@components/SEOHead.astro";
import { getLocaleFromUrl, useTranslations } from "@i18n/utils";
import type { Locale } from "@i18n/config";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
}

const locale: Locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const {
  title = t("site.title"),
  description = t("site.description"),
  ogImage,
  ogType,
  noindex,
} = Astro.props;

const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang={locale} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <!-- SEO: meta, OG, Twitter, canonical, hreflang -->
    <SEOHead
      title={title}
      description={description}
      locale={locale}
      pathname={pathname}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
    />

    <!-- Fuentes -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body>
    <a href="#main-content" class="skip-to-content">
      {locale === "es" ? "Ir al contenido principal" : "Skip to main content"}
    </a>

    <Header />

    <main id="main-content">
      <slot />
    </main>

    <Footer />

    <!-- Theme toggle script: persiste preferencia del usuario -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem("theme");
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;
        const theme = stored || (prefersDark ? "dark" : "light");
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
  </body>
</html>
