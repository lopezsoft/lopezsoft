---
// ==========================================================================
// LOPEZSOFT SAS — Componente Product/Service Card
// ==========================================================================
interface Props {
  name: string;
  description: string;
  features: string[];
  image: string;
  imageAlt?: string;
  url?: string;
  urlLabel?: string;
  comingSoonLabel?: string;
}

const {
  name,
  description,
  features,
  image,
  imageAlt = name,
  url,
  urlLabel,
  comingSoonLabel,
} = Astro.props;
---

<article class="product-card hover-lift reveal">
  <div class="product-card__image-wrapper">
    <img
      src={image}
      alt={imageAlt}
      class="product-card__image"
      width="400"
      height="400"
      loading="lazy"
    />
  </div>
  <div class="product-card__body">
    <h3 class="product-card__name">{name}</h3>
    <p class="product-card__description">{description}</p>
    <ul class="product-card__features">
      {
        features.map((feature) => (
          <li class="product-card__feature">
            <svg
              class="product-card__feature-icon"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 20 20"
              fill="currentColor"
              width="16"
              height="16"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z"
                clip-rule="evenodd"
              />
            </svg>
            <span>{feature}</span>
          </li>
        ))
      }
    </ul>
    {
      url ? (
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          class="product-card__link"
        >
          <span>{urlLabel}</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 20 20"
            fill="currentColor"
            width="16"
            height="16"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M4.25 5.5a.75.75 0 00-.75.75v8.5c0 .414.336.75.75.75h8.5a.75.75 0 00.75-.75v-4a.75.75 0 011.5 0v4A2.25 2.25 0 0112.75 17h-8.5A2.25 2.25 0 012 14.75v-8.5A2.25 2.25 0 014.25 4h5a.75.75 0 010 1.5h-5zm7.25-.75a.75.75 0 01.75-.75h3.5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0V6.31l-5.47 5.47a.75.75 0 11-1.06-1.06l5.47-5.47H12.25a.75.75 0 01-.75-.75z"
              clip-rule="evenodd"
            />
          </svg>
        </a>
      ) : comingSoonLabel ? (
        <span class="product-card__coming-soon">{comingSoonLabel}</span>
      ) : null
    }
  </div>
</article>
