---
// ==========================================================================
// LOPEZSOFT SAS — Componente Button
// ==========================================================================
interface Props {
  variant?: "primary" | "secondary" | "warm";
  size?: "sm" | "md" | "lg";
  href?: string;
  class?: string;
}

const {
  variant = "primary",
  size = "md",
  href,
  class: className = "",
} = Astro.props;

const classes = [
  "btn",
  `btn--${variant}`,
  size !== "md" ? `btn--${size}` : "",
  className,
]
  .filter(Boolean)
  .join(" ");
---

{
  href ? (
    <a href={href} class={classes}>
      <slot />
    </a>
  ) : (
    <button class={classes}>
      <slot />
    </button>
  )
}
