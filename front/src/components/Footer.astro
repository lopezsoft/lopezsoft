---
// ==========================================================================
// LOPEZSOFT SAS — Componente Footer
// ==========================================================================
import type { Locale } from "@i18n/config";
import {
  getLocaleFromUrl,
  useTranslations,
  getLocalizedPath,
} from "@i18n/utils";

const locale: Locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const year = new Date().getFullYear();

const navLinks = [
  { key: "nav.home", href: getLocalizedPath("/", locale) },
  { key: "nav.services", href: getLocalizedPath("/services", locale) },
  { key: "nav.about", href: getLocalizedPath("/about", locale) },
  { key: "nav.contact", href: getLocalizedPath("/contact", locale) },
];

const legalLinks = [
  { key: "footer.links.privacy", href: getLocalizedPath("/privacy", locale) },
  { key: "footer.links.terms", href: getLocalizedPath("/data-protection", locale) },
];
---

<footer class="footer">
  <div class="footer__inner">
    <div class="footer__grid">
      <!-- Marca + info -->
      <div class="footer__brand">
        <img
          src="/images/logo/logo-horizontal.png"
          alt="LOPEZSOFT SAS"
          class="footer__logo footer__logo--light"
          width="160"
          height="48"
          loading="lazy"
        />
        <img
          src="/images/logo/logo-horizontal-blue.png"
          alt="LOPEZSOFT SAS"
          class="footer__logo footer__logo--dark"
          width="160"
          height="48"
          loading="lazy"
        />
        <p class="footer__slogan">{t("footer.slogan")}</p>
        <p class="footer__description">{t("footer.description")}</p>

        <!-- Contacto directo -->
        <div class="footer__contact">
          <a href={`mailto:${t("footer.email")}`} class="footer__contact-item">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="16" height="16" aria-hidden="true">
              <path d="M3 4a2 2 0 00-2 2v1.161l8.441 4.221a1.25 1.25 0 001.118 0L19 7.162V6a2 2 0 00-2-2H3z"/>
              <path d="M19 8.839l-7.77 3.885a2.75 2.75 0 01-2.46 0L1 8.839V14a2 2 0 002 2h14a2 2 0 002-2V8.839z"/>
            </svg>
            <span>{t("footer.email")}</span>
          </a>
          <a href={`tel:${t("footer.phone_support")}`} class="footer__contact-item">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="16" height="16" aria-hidden="true">
              <path fill-rule="evenodd" d="M2 3.5A1.5 1.5 0 013.5 2h1.148a1.5 1.5 0 011.465 1.175l.716 3.223a1.5 1.5 0 01-1.052 1.767l-.933.267c-.41.117-.643.555-.48.95a11.542 11.542 0 006.254 6.254c.395.163.833-.07.95-.48l.267-.933a1.5 1.5 0 011.767-1.052l3.223.716A1.5 1.5 0 0118 15.352V16.5a1.5 1.5 0 01-1.5 1.5H15c-1.149 0-2.263-.15-3.326-.43A13.022 13.022 0 012.43 8.326 13.019 13.019 0 012 5V3.5z" clip-rule="evenodd"/>
            </svg>
            <span>{t("footer.phone_support_label")}: {t("footer.phone_support")}</span>
          </a>
          <a href={`tel:${t("footer.phone_sales")}`} class="footer__contact-item">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="16" height="16" aria-hidden="true">
              <path fill-rule="evenodd" d="M2 3.5A1.5 1.5 0 013.5 2h1.148a1.5 1.5 0 011.465 1.175l.716 3.223a1.5 1.5 0 01-1.052 1.767l-.933.267c-.41.117-.643.555-.48.95a11.542 11.542 0 006.254 6.254c.395.163.833-.07.95-.48l.267-.933a1.5 1.5 0 011.767-1.052l3.223.716A1.5 1.5 0 0118 15.352V16.5a1.5 1.5 0 01-1.5 1.5H15c-1.149 0-2.263-.15-3.326-.43A13.022 13.022 0 012.43 8.326 13.019 13.019 0 012 5V3.5z" clip-rule="evenodd"/>
            </svg>
            <span>{t("footer.phone_sales_label")}: {t("footer.phone_sales")}</span>
          </a>
          <span class="footer__contact-item">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="16" height="16" aria-hidden="true">
              <path fill-rule="evenodd" d="M9.69 18.933l.003.001C9.89 19.02 10 19 10 19s.11.02.308-.066l.002-.001.006-.003.018-.008a5.741 5.741 0 00.281-.14c.186-.096.446-.24.757-.433.62-.384 1.445-.966 2.274-1.765C15.302 14.988 17 12.493 17 9A7 7 0 103 9c0 3.492 1.698 5.988 3.355 7.584a13.731 13.731 0 002.274 1.765 11.307 11.307 0 00.757.433c.11.057.194.098.238.12l.04.02.01.005.004.002zM10 11.25a2.25 2.25 0 100-4.5 2.25 2.25 0 000 4.5z" clip-rule="evenodd"/>
            </svg>
            <span>{t("footer.address")}</span>
          </span>
        </div>
      </div>

      <!-- Navegación -->
      <nav aria-label={locale === "es" ? "Enlaces del pie de página" : "Footer navigation"}>
        <h3 class="footer__heading">{t("nav.home")}</h3>
        <ul class="footer__links">
          {
            navLinks.map(({ key, href }) => (
              <li>
                <a href={href} class="footer__link">
                  {t(key)}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Legal -->
      <div>
        <h3 class="footer__heading">Legal</h3>
        <ul class="footer__links">
          {
            legalLinks.map(({ key, href }) => (
              <li>
                <a href={href} class="footer__link">
                  {t(key)}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <div class="footer__bottom">
    <p class="footer__copy">
      &copy; {year} LOPEZSOFT SAS. {t("footer.rights")}
    </p>
  </div>
</footer>
