---
// ==========================================================================
// LOPEZSOFT SAS — Componente SEO Head
// Inyecta meta tags dinámicos, Open Graph, Twitter Card, canonical y hreflang
// ==========================================================================
import type { Locale } from "@i18n/config";
import { LOCALE_CODES } from "@i18n/config";
import { getLocalizedPath } from "@i18n/utils";

interface Props {
  title: string;
  description: string;
  locale: Locale;
  pathname: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
}

const SITE_URL = import.meta.env.SITE || "https://lopezsoft.com";

const {
  title,
  description,
  locale,
  pathname,
  ogImage = "/images/logo/logo-horizontal.png",
  ogType = "website",
  noindex = false,
} = Astro.props;

// Canonical URL (siempre la URL actual sin trailing slash extra)
const canonicalURL = new URL(pathname, SITE_URL).href;

// Generar hreflang alternates para i18n
const hreflangs = LOCALE_CODES.map((lang) => {
  const localizedPath = getLocalizedPath(pathname, lang);
  return {
    lang,
    href: new URL(localizedPath, SITE_URL).href,
  };
});

// OpenGraph locale format
const ogLocale = locale === "es" ? "es_CO" : "en_US";
const ogLocaleAlternate = locale === "es" ? "en_US" : "es_CO";

const ogImageURL = new URL(ogImage, SITE_URL).href;

// JSON-LD: Organization + WebSite
const organizationLD = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "LOPEZSOFT SAS",
  url: SITE_URL,
  logo: new URL("/images/logo/logo-horizontal.png", SITE_URL).href,
  description: locale === "es"
    ? "Ecosistema tecnológico enfocado en soluciones B2B para empresas colombianas."
    : "Technology ecosystem focused on B2B solutions for Colombian businesses.",
  contactPoint: {
    "@type": "ContactPoint",
    telephone: "+57-310-843-5431",
    contactType: "customer service",
    email: "gerencia@lopezsoft.net.co",
    areaServed: "CO",
    availableLanguage: ["Spanish", "English"],
  },
  address: {
    "@type": "PostalAddress",
    addressLocality: "Dosquebradas",
    addressRegion: "Risaralda",
    addressCountry: "CO",
  },
  sameAs: [],
};

const webSiteLD = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "LOPEZSOFT SAS",
  url: SITE_URL,
  inLanguage: [locale === "es" ? "es-CO" : "en-US"],
};
---

<!-- SEO Meta -->
<meta name="description" content={description} />
<meta name="author" content="LOPEZSOFT SAS" />
<meta name="theme-color" content="#0F172A" />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Canonical -->
<link rel="canonical" href={canonicalURL} />

<!-- Hreflang alternates -->
{hreflangs.map(({ lang, href }) => (
  <link rel="alternate" hreflang={lang} href={href} />
))}
<link rel="alternate" hreflang="x-default" href={new URL("/", SITE_URL).href} />

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content="LOPEZSOFT SAS" />
<meta property="og:locale" content={ogLocale} />
<meta property="og:locale:alternate" content={ogLocaleAlternate} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />

<!-- JSON-LD Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(organizationLD)} />
<script type="application/ld+json" set:html={JSON.stringify(webSiteLD)} />
