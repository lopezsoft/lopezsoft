---
// ==========================================================================
// LOPEZSOFT SAS — Banner Temporal: Feria Caldas Más Digital 2026
// --------------------------------------------------------------------------
// Flujo: Formulario → Webhook Google Sheets → WhatsApp → Demo Sandbox
// La visibilidad del componente la controla index.astro vía JS client-side.
// ==========================================================================

const whatsappNumber = '573108435431';
const webhookUrl = import.meta.env.PUBLIC_LEADS_WEBHOOK || '';

// Demo Sandbox
const demoUrl = 'https://apps.matias.com.co/#/auth/login';
const demoEmail = 'demo@matias.com.co';
const demoPass = 'DEMO123456';

const habeasDataText =
  'Autorizo a LOPEZSOFT SAS el tratamiento de mis datos personales conforme a la Ley 1581 de 2012 y su Política de Privacidad, con fines comerciales y de contacto.';
---

<section class="fb" aria-label="Banner Feria Caldas Más Digital 2026">
    <div class="fb__bg-orb fb__bg-orb--1" aria-hidden="true"></div>
    <div class="fb__bg-orb fb__bg-orb--2" aria-hidden="true"></div>

    <div class="fb__inner container">
      {/* === Columna Izquierda === */}
      <div class="fb__content">
        <span class="fb__badge">🎪 Feria Caldas Más Digital · Chinchiná</span>
        <h1 class="fb__title">
          Chinchiná se conecta con el futuro.
          <span class="fb__title-gold">Optimice su negocio hoy.</span>
        </h1>
        <p class="fb__desc">
          Facture electrónicamente ante la DIAN, controle su caja y gestione
          inventario con <strong>Matias ERP 3.0</strong> — la solución para
          comerciantes que quieren crecer.
        </p>
        <p class="fb__schedule">
          📅 Mié. 27 mayo: 9:00 a.m. – 4:00 p.m. &nbsp;|&nbsp;
          Jue. 28 mayo: 9:00 a.m. – 1:00 p.m.
        </p>
        <div class="fb__ctas">
          <a id="feria-cta-whatsapp" href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent('Hola, visito su stand en Chinchiná y deseo más información sobre Matias ERP')}`} target="_blank" rel="noopener noreferrer" class="fb__btn fb__btn--wa">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Hablar con un Asesor
          </a>
          <a id="feria-cta-demo" href={demoUrl} target="_blank" rel="noopener noreferrer" class="fb__btn fb__btn--ghost">
            Ver Demo Matias ERP
          </a>
        </div>
      </div>

      {/* === Columna Derecha — Formulario + Panel Demo === */}
      <div class="fb__card">
        <div class="fb__card-glow" aria-hidden="true"></div>

        {/* --- Panel del formulario (visible inicialmente) --- */}
        <div id="feria-form-panel">
          <h2 class="fb__card-title">🚀 Activa tu Demo de Matias ERP</h2>
          <p class="fb__card-desc">Registra tus datos y accede al sistema de inmediato.</p>

          <form class="fb__form" id="feria-lead-form" novalidate
            data-webhook={webhookUrl}
            data-wa={whatsappNumber}
            data-demo-url={demoUrl}>
            <div class="fb__field">
              <label class="fb__label" for="fl-name">Nombre Completo *</label>
              <input class="fb__input" type="text" id="fl-name" name="fullName" required minlength="2" maxlength="100" autocomplete="name" placeholder="Ej: Carlos Rodríguez" aria-describedby="fl-name-error" />
              <span class="fb__err" id="fl-name-error" data-error="fullName" role="alert"></span>
            </div>
            <div class="fb__field">
              <label class="fb__label" for="fl-business">Nombre del Negocio *</label>
              <input class="fb__input" type="text" id="fl-business" name="businessName" required minlength="2" maxlength="100" autocomplete="organization" placeholder="Ej: Café del Valle S.A.S" aria-describedby="fl-business-error" />
              <span class="fb__err" id="fl-business-error" data-error="businessName" role="alert"></span>
            </div>
            <div class="fb__field">
              <label class="fb__label" for="fl-phone">Celular / WhatsApp *</label>
              <input class="fb__input" type="tel" id="fl-phone" name="phone" required minlength="7" maxlength="15" autocomplete="tel" placeholder="Ej: 300 123 4567" inputmode="tel" aria-describedby="fl-phone-error" />
              <span class="fb__err" id="fl-phone-error" data-error="phone" role="alert"></span>
            </div>
            <div class="fb__field fb__field--check">
              <label class="fb__check-label" for="fl-consent">
                <input class="fb__checkbox" type="checkbox" id="fl-consent" name="consent" required aria-describedby="fl-consent-error" data-error-msg="Debe autorizar el tratamiento de datos." />
                <span class="fb__check-text">{habeasDataText}</span>
              </label>
              <span class="fb__err" id="fl-consent-error" data-error="consent" role="alert"></span>
            </div>
            <button id="feria-submit-btn" class="fb__submit" type="submit">
              Activar Demo Gratis
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </button>
            <div class="fb__msg fb__msg--fail" id="fl-error" role="alert" aria-live="assertive" hidden>
              ⚠️ Revisa los campos marcados e intenta de nuevo.
            </div>
          </form>
        </div>

        {/* --- Panel de éxito + Demo Sandbox (oculto inicialmente) --- */}
        <div id="feria-success-panel" class="fb__success" hidden>
          <div class="fb__success-icon">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
          </div>
          <h2 class="fb__success-title">¡Registro Exitoso!</h2>
          <p class="fb__success-desc">
            Tus datos han sido enviados a un asesor. Mientras tanto, comienza a explorar <strong>Matias ERP 3.0</strong> ahora mismo:
          </p>

          <div class="fb__demo-ticket">
            <div class="fb__demo-ticket-header">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M2.5 3A1.5 1.5 0 001 4.5v11A1.5 1.5 0 002.5 17h15a1.5 1.5 0 001.5-1.5v-11A1.5 1.5 0 0017.5 3h-15zm.75 3a.75.75 0 000 1.5h13.5a.75.75 0 000-1.5H3.25zM2 9.5a.5.5 0 01.5-.5h4a.5.5 0 010 1h-4a.5.5 0 01-.5-.5zm0 3a.5.5 0 01.5-.5h4a.5.5 0 010 1h-4a.5.5 0 01-.5-.5zm7-3a.5.5 0 01.5-.5h4a.5.5 0 010 1h-4a.5.5 0 01-.5-.5zm0 3a.5.5 0 01.5-.5h4a.5.5 0 010 1h-4a.5.5 0 01-.5-.5z" clip-rule="evenodd" />
              </svg>
              Credenciales de Acceso
            </div>
            <div class="fb__demo-cred">
              <div class="fb__demo-row">
                <span class="fb__demo-lbl">Usuario:</span>
                <code class="fb__demo-val">{demoEmail}</code>
              </div>
              <div class="fb__demo-row">
                <span class="fb__demo-lbl">Clave:</span>
                <code class="fb__demo-val">{demoPass}</code>
              </div>
            </div>
            <a href={demoUrl} target="_blank" rel="noopener noreferrer" class="fb__demo-action">
              Ingresar al Sandbox 
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </a>
          </div>
          <p class="fb__demo-note">
            Este entorno contiene datos de prueba seguros. Tu cuenta privada con facturación real a la DIAN será configurada por tu asesor.
          </p>
        </div>
      </div>
    </div>
  </section>
<script is:inline>
  // Debug incondicional para saber que el script SÍ cargó
  console.log('[Feria] Script inicializado. Escuchando eventos del formulario...');

  document.addEventListener('submit', function(e) {
    const form = e.target;
    if (!form || form.id !== 'feria-lead-form') return;
    
    e.preventDefault(); // Prevenir el reset inmediato
    console.log('[Feria] 🎯 Formulario interceptado correctamente.');

    const webhookUrl = form.dataset.webhook || '';
    const waNumber = form.dataset.wa || '';

    const showError = (field, msg) => {
      const el = form.querySelector(`[data-error="${field}"]`);
      if (el) { el.textContent = msg; el.classList.add('is-visible'); }
    };

    const clearErrors = () => {
      form.querySelectorAll('.fb__err').forEach(el => {
        el.textContent = ''; el.classList.remove('is-visible');
      });
    };

    const validateField = (input) => {
      const name = input.name;
      const value = input.value;
      const trimmed = value.trim();
      
      if (input.required && !trimmed) { showError(name, 'Este campo es obligatorio.'); return false; }
      
      const min = input.getAttribute('minlength');
      if (min && trimmed.length < parseInt(min, 10)) { showError(name, `Mínimo ${min} caracteres.`); return false; }
      
      if (name === 'phone' && trimmed) {
        const digits = trimmed.replace(/\D/g, '');
        if (digits.length < 7 || digits.length > 15) { showError(name, 'Ingrese un número válido.'); return false; }
      }
      return true;
    };

    clearErrors();
    const errorContainer = document.getElementById('fl-error');
    if (errorContainer) errorContainer.setAttribute('hidden', '');

    const inputs = form.querySelectorAll("input:not([type='checkbox'])");
    let isValid = true;
    inputs.forEach(input => { if (!validateField(input)) isValid = false; });

    const consent = form.querySelector('#fl-consent');
    if (consent && !consent.checked) { 
      showError('consent', consent.dataset.errorMsg || 'Requerido'); 
      isValid = false; 
    }

    if (!isValid) { 
      if (errorContainer) errorContainer.removeAttribute('hidden'); 
      return; 
    }

    // Recoger datos
    const formData = {};
    inputs.forEach(input => { formData[input.name] = input.value.trim(); });

    console.log('[Feria] 📦 Datos válidos listos para enviar:', formData);

    // 1. Enviar a Webhook
    const consentEl = form.querySelector('#fl-consent');
    const payloadData = { 
      nombre: formData.fullName,
      negocio: formData.businessName,
      celular: formData.phone,
      habeasData: consentEl && consentEl.checked ? true : false,
      source: 'feria-chinchina-2026' 
    };
    const payloadString = JSON.stringify(payloadData);
    
    if (webhookUrl) {
      console.log('[Feria] 📤 Enviando a webhook:', webhookUrl);
      if (navigator.sendBeacon) {
        // Enviar como string de texto (text/plain) para que Apps Script haga JSON.parse()
        const sent = navigator.sendBeacon(webhookUrl, payloadString);
        console.log('[Feria] sendBeacon status:', sent);
      } else {
        fetch(webhookUrl, {
          method: 'POST',
          mode: 'no-cors',
          headers: { 'Content-Type': 'text/plain' },
          body: payloadString
        }).then(() => console.log('[Feria] fetch enviado'));
      }
    } else {
      console.warn('[Feria] ⚠️ No hay webhookUrl configurado.');
    }

    // 2. Abrir WhatsApp
    if (waNumber) {
      const msg = [
        '\u{1F3AA} *Nuevo Lead - Feria Caldas Mas Digital*',
        `\u{1F464} Nombre: ${formData.fullName}`,
        `\u{1F3EA} Negocio: ${formData.businessName}`,
        `\u{1F4F1} Celular: ${formData.phone}`,
        `\u{1F550} Registrado: ${new Date().toLocaleString('es-CO')}`,
        '\u{1F4A1} Interesado en Demo Matias ERP 3.0',
      ].join('\n');
      window.open(`https://wa.me/${waNumber}?text=${encodeURIComponent(msg)}`, '_blank');
    }

    // 3. Mostrar panel de demo sandbox
    const formPanel = document.getElementById('feria-form-panel');
    const successPanel = document.getElementById('feria-success-panel');
    
    if (formPanel) formPanel.setAttribute('hidden', '');
    if (successPanel) {
      successPanel.removeAttribute('hidden');
      successPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  });
</script>

<style>
  @keyframes fb-fadeUp {
    from { opacity: 0; transform: translateY(1.5rem); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes fb-glow {
    0%, 100% { opacity: 0.4; }
    50%      { opacity: 0.8; }
  }
  @keyframes fb-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.4); }
    50%      { box-shadow: 0 0 0 10px rgba(245, 158, 11, 0); }
  }

  .fb {
    position: relative;
    overflow: hidden;
    background: linear-gradient(155deg, #0F172A 0%, #0d1f4a 40%, #1e40af 100%);
    padding: 1.5rem 0 3rem;
  }
  @media (min-width: 768px) { .fb { padding: 3rem 0 4.5rem; } }
  @media (min-width: 1024px) { .fb { padding: 4rem 0 6rem; } }

  .fb__bg-orb { position: absolute; border-radius: 50%; filter: blur(80px); pointer-events: none; }
  .fb__bg-orb--1 { width: 300px; height: 300px; background: rgba(37,99,235,0.25); top: -80px; left: -60px; animation: fb-glow 6s ease-in-out infinite; }
  .fb__bg-orb--2 { width: 250px; height: 250px; background: rgba(245,158,11,0.12); bottom: -50px; right: -40px; animation: fb-glow 6s ease-in-out 3s infinite; }

  .fb__inner { position: relative; z-index: 1; display: flex; flex-direction: column; gap: 1.5rem; }
  @media (min-width: 768px) { .fb__inner { flex-direction: row; align-items: center; gap: 2.5rem; } }
  @media (min-width: 1024px) { .fb__inner { gap: 3.5rem; } }

  .fb__content { display: flex; flex-direction: column; gap: 0.75rem; animation: fb-fadeUp 0.6s ease both; }
  @media (min-width: 768px) { .fb__content { flex: 1; gap: 1rem; } }

  .fb__badge { display: inline-flex; align-items: center; gap: 0.375rem; width: fit-content; padding: 0.375rem 0.875rem; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #F59E0B; background: rgba(245,158,11,0.12); border: 1px solid rgba(245,158,11,0.3); border-radius: 9999px; backdrop-filter: blur(8px); }

  .fb__title { color: #FFFFFF; font-size: 1.625rem; font-weight: 800; line-height: 1.2; max-width: 34rem; margin: 0; }
  @media (min-width: 640px) { .fb__title { font-size: 2rem; } }
  @media (min-width: 768px) { .fb__title { font-size: 2.25rem; } }
  @media (min-width: 1024px) { .fb__title { font-size: 2.75rem; } }
  .fb__title-gold { display: block; color: #F59E0B; margin-top: 0.25rem; }

  .fb__desc { color: rgba(255,255,255,0.7); font-size: 0.85rem; line-height: 1.6; max-width: 30rem; margin: 0; }
  .fb__desc strong { color: #F59E0B; font-weight: 700; }
  @media (min-width: 768px) { .fb__desc { font-size: 0.95rem; } }

  .fb__schedule { color: rgba(255,255,255,0.55); font-size: 0.75rem; margin: 0; padding: 0.375rem 0.75rem; background: rgba(255,255,255,0.06); border-radius: 0.375rem; border: 1px solid rgba(255,255,255,0.08); line-height: 1.5; }
  @media (min-width: 768px) { .fb__schedule { font-size: 0.8rem; } }

  .fb__ctas { display: flex; flex-direction: column; gap: 0.625rem; margin-top: 0.25rem; }
  @media (min-width: 480px) { .fb__ctas { flex-direction: row; flex-wrap: wrap; } }

  .fb__btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 0.75rem 1.5rem; font-family: 'Inter', system-ui, sans-serif; font-size: 0.9rem; font-weight: 600; line-height: 1.25; text-decoration: none; border-radius: 0.5rem; border: 2px solid transparent; cursor: pointer; transition: all 0.2s ease; }
  .fb__btn--wa { background-color: #2563EB; color: #FFF; border-color: #2563EB; }
  .fb__btn--wa:hover { background-color: #1d4ed8; border-color: #1d4ed8; color: #FFF; transform: translateY(-1px); box-shadow: 0 4px 14px rgba(37,99,235,0.4); }
  .fb__btn--ghost { background: transparent; color: rgba(255,255,255,0.85); border-color: rgba(255,255,255,0.3); }
  .fb__btn--ghost:hover { background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.6); color: #FFF; }
  .fb__btn svg { flex-shrink: 0; }

  /* --- Card --- */
  .fb__card { position: relative; width: 100%; background: rgba(255,255,255,0.06); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border: 1px solid rgba(255,255,255,0.1); border-radius: 1rem; padding: 1.25rem; display: flex; flex-direction: column; gap: 0.75rem; animation: fb-fadeUp 0.6s ease 0.15s both; }
  @media (min-width: 768px) { .fb__card { flex: 0 0 340px; max-width: 380px; padding: 1.5rem; gap: 1rem; } }
  @media (min-width: 1024px) { .fb__card { flex: 0 0 400px; max-width: 420px; padding: 1.75rem; } }

  .fb__card-glow { position: absolute; inset: -2px; border-radius: 1rem; background: linear-gradient(135deg, rgba(37,99,235,0.3), rgba(245,158,11,0.2)); z-index: -1; filter: blur(20px); opacity: 0.5; animation: fb-glow 4s ease-in-out infinite; }

  .fb__card-title { font-size: 1.1rem; font-weight: 700; color: #FFF; margin: 0; display: flex; align-items: center; gap: 0.5rem; }
  @media (min-width: 768px) { .fb__card-title { font-size: 1.25rem; } }
  .fb__card-desc { font-size: 0.75rem; color: rgba(255,255,255,0.55); margin: 0; line-height: 1.5; }

  /* --- Form --- */
  .fb__form { display: flex; flex-direction: column; gap: 0.625rem; }
  @media (min-width: 768px) { .fb__form { gap: 0.75rem; } }
  .fb__field { display: flex; flex-direction: column; gap: 0.25rem; }
  .fb__label { font-size: 0.7rem; font-weight: 600; color: rgba(255,255,255,0.8); letter-spacing: 0.02em; }
  @media (min-width: 768px) { .fb__label { font-size: 0.8rem; } }

  .fb__input { width: 100%; padding: 0.5rem 0.75rem; font-size: 0.85rem; font-family: 'Inter', system-ui, sans-serif; color: #FFF; background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.15); border-radius: 0.5rem; outline: none; transition: border-color 0.2s, background-color 0.2s, box-shadow 0.2s; }
  @media (min-width: 768px) { .fb__input { padding: 0.625rem 0.875rem; font-size: 0.9rem; } }
  .fb__input::placeholder { color: rgba(255,255,255,0.3); }
  .fb__input:focus { border-color: #F59E0B; background: rgba(255,255,255,0.1); box-shadow: 0 0 0 3px rgba(245,158,11,0.15); }

  .fb__err { display: none; font-size: 0.7rem; color: #EF4444; font-weight: 500; }
  .fb__err.is-visible { display: block; }

  .fb__field--check { margin-top: 0.125rem; }
  .fb__check-label { display: flex; gap: 0.5rem; align-items: flex-start; cursor: pointer; }
  .fb__checkbox { flex-shrink: 0; width: 1rem; height: 1rem; margin-top: 0.125rem; accent-color: #F59E0B; cursor: pointer; }
  .fb__check-text { font-size: 0.65rem; color: rgba(255,255,255,0.5); line-height: 1.6; }
  @media (min-width: 768px) { .fb__check-text { font-size: 0.7rem; } }

  .fb__submit { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; width: 100%; padding: 0.75rem 1.5rem; margin-top: 0.25rem; font-family: 'Inter', system-ui, sans-serif; font-size: 0.95rem; font-weight: 700; color: #0F172A; background: linear-gradient(135deg, #F59E0B, #FBBF24); border: none; border-radius: 0.5rem; cursor: pointer; transition: all 0.2s ease; animation: fb-pulse 2.5s ease-in-out infinite; }
  .fb__submit:hover { animation: none; background: linear-gradient(135deg, #D97706, #F59E0B); transform: translateY(-1px); box-shadow: 0 4px 14px rgba(245,158,11,0.4); }
  .fb__submit svg { flex-shrink: 0; }

  .fb__msg { padding: 0.75rem 1rem; font-size: 0.8rem; font-weight: 500; border-radius: 0.5rem; text-align: center; }
  .fb__msg--fail { color: #EF4444; background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3); }

  /* --- Success Panel Premium Redesign --- */
  .fb__success { display: flex; flex-direction: column; align-items: center; gap: 1rem; text-align: center; animation: fb-fadeUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) both; width: 100%; }
  
