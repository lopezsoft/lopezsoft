---
// ==========================================================================
// LOPEZSOFT SAS — Componente Formulario de Contacto
// ==========================================================================
import type { Locale } from "@i18n/config";
import { useTranslations } from "@i18n/utils";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const dataProtectionPath = lang === "es" ? "/data-protection" : "/en/data-protection";
---

<form class="contact-form" id="contact-form" novalidate>
  <div class="contact-form__group">
    <label class="contact-form__label" for="cf-name">
      {t("contact.form.name")}
    </label>
    <input
      class="contact-form__input"
      type="text"
      id="cf-name"
      name="name"
      required
      minlength="2"
      maxlength="100"
      autocomplete="name"
      aria-describedby="cf-name-error"
    />
    <span class="contact-form__error" id="cf-name-error" data-error="name" role="alert"></span>
  </div>

  <div class="contact-form__group">
    <label class="contact-form__label" for="cf-email">
      {t("contact.form.email")}
    </label>
    <input
      class="contact-form__input"
      type="email"
      id="cf-email"
      name="email"
      required
      autocomplete="email"
      aria-describedby="cf-email-error"
    />
    <span class="contact-form__error" id="cf-email-error" data-error="email" role="alert"></span>
  </div>

  <div class="contact-form__group">
    <label class="contact-form__label" for="cf-company">
      {t("contact.form.company")}
    </label>
    <input
      class="contact-form__input"
      type="text"
      id="cf-company"
      name="company"
      maxlength="100"
      autocomplete="organization"
    />
  </div>

  <div class="contact-form__group">
    <label class="contact-form__label" for="cf-message">
      {t("contact.form.message")}
    </label>
    <textarea
      class="contact-form__input contact-form__input--textarea"
      id="cf-message"
      name="message"
      required
      minlength="10"
      maxlength="2000"
      rows="5"
      aria-describedby="cf-message-error"></textarea>
    <span class="contact-form__error" id="cf-message-error" data-error="message" role="alert"></span>
  </div>

  <div class="contact-form__group contact-form__group--checkbox">
    <label class="contact-form__checkbox-label" for="cf-consent">
      <input
        class="contact-form__checkbox"
        type="checkbox"
        id="cf-consent"
        name="consent"
        required
        aria-describedby="cf-consent-error"
        data-error-msg={t("contact.form.consent_required")}
      />
      <span class="contact-form__checkbox-text">
        {t("contact.form.consent")}
        <a href={dataProtectionPath} target="_blank" rel="noopener noreferrer" class="contact-form__checkbox-link">
          {t("contact.form.consent_link")}
        </a>
      </span>
    </label>
    <span class="contact-form__error" id="cf-consent-error" data-error="consent" role="alert"></span>
  </div>

  <button class="btn btn--primary btn--lg contact-form__submit" type="submit">
    {t("contact.form.submit")}
  </button>

  <div
    class="contact-form__feedback contact-form__feedback--success"
    id="cf-success"
    role="status"
    aria-live="polite"
    hidden
  >
    {t("contact.form.success")}
  </div>
  <div
    class="contact-form__feedback contact-form__feedback--error"
    id="cf-error"
    role="alert"
    aria-live="assertive"
    hidden
  >
    {t("contact.form.error")}
  </div>
</form>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById(
      "contact-form",
    ) as HTMLFormElement | null;
    if (!form) return;

    const showError = (field: string, message: string) => {
      const el = form.querySelector(`[data-error="${field}"]`);
      if (el) {
        el.textContent = message;
        el.classList.add("is-visible");
      }
    };

    const clearErrors = () => {
      form.querySelectorAll(".contact-form__error").forEach((el) => {
        el.textContent = "";
        el.classList.remove("is-visible");
      });
    };

    const validateField = (
      input: HTMLInputElement | HTMLTextAreaElement,
    ): boolean => {
      const { name, value, type } = input;
      const trimmed = value.trim();

      if (input.required && !trimmed) {
        showError(
          name,
          input.type === "email"
            ? "Email is required"
            : "This field is required",
        );
        return false;
      }

      if (type === "email" && trimmed) {
        const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailPattern.test(trimmed)) {
          showError(name, "Please enter a valid email");
          return false;
        }
      }

      const min = input.getAttribute("minlength");
      if (min && trimmed.length < parseInt(min, 10)) {
        showError(name, `Minimum ${min} characters`);
        return false;
      }

      return true;
    };

    form.addEventListener("submit", (e) => {
      e.preventDefault();

      clearErrors();
      document.getElementById("cf-success")?.setAttribute("hidden", "");
      document.getElementById("cf-error")?.setAttribute("hidden", "");

      const inputs = form.querySelectorAll<
        HTMLInputElement | HTMLTextAreaElement
      >("input:not([type='checkbox']), textarea");

      let isValid = true;
      inputs.forEach((input) => {
        if (!validateField(input)) isValid = false;
      });

      // Validate consent checkbox
      const consent = form.querySelector<HTMLInputElement>("#cf-consent");
      if (consent && !consent.checked) {
        showError("consent", consent.dataset.errorMsg || "Required");
        isValid = false;
      }

      if (!isValid) return;

      // Show success (backend integration in Sprint 5)
      document.getElementById("cf-success")?.removeAttribute("hidden");
      form.reset();
    });
  });
</script>
