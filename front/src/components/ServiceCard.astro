---

<article class="service-card hover-lift reveal">
  <div class="service-card__icon-wrapper">
    <svg
      class="service-card__icon"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
