---
// ==========================================================================
// LOPEZSOFT SAS — Página Home (ES)
// ==========================================================================
import MainLayout from "@layouts/MainLayout.astro";
import Hero from "@components/Hero.astro";
import ProductCard from "@components/ProductCard.astro";
import Button from "@components/Button.astro";
import { useTranslations, getLocalizedPath } from "@i18n/utils";
import { DEFAULT_LOCALE } from "@i18n/config";

const t = useTranslations(DEFAULT_LOCALE);

const products = [
	{ key: "matias_erp", image: "/images/products/erp-500.png" },
	{ key: "matias_api", image: "/images/products/api-500.png" },
	{ key: "matias_impulso", image: "/images/products/impulso-500.png" },
	{ key: "asaie_exodo", image: "/images/products/asaie-exodo-icon.png" },
];
---

<MainLayout description={t("seo.home.description")}>
	<Hero lang={DEFAULT_LOCALE} />

	<!-- Sección Productos -->
	<section id="products" class="section section--alt">
		<div class="container">
			<div class="section__header reveal">
				<h2 class="section__title">{t("products.title")}</h2>
				<p class="section__subtitle">{t("products.subtitle")}</p>
			</div>
			<div class="section__grid">
				{
					products.map(({ key, image }) => {
						const productUrl = t(`products.${key}.url`);
						return (
							<ProductCard
								name={t(`products.${key}.name`)}
								description={t(`products.${key}.description`)}
								features={[
									t(`products.${key}.features.0`),
									t(`products.${key}.features.1`),
									t(`products.${key}.features.2`),
									t(`products.${key}.features.3`),
								]}
								image={image}
								url={productUrl || undefined}
								urlLabel={t("products.visit_site")}
								comingSoonLabel={!productUrl ? t("products.coming_soon") : undefined}
							/>
						);
					})
				}
			</div>
			<div class="section__cta">
				<Button
					variant="primary"
					size="lg"
					href={getLocalizedPath("/services", DEFAULT_LOCALE)}
				>
					{t("products.cta")}
				</Button>
			</div>
		</div>
	</section>

	<!-- Sección Nosotros Preview -->
	<section class="section">
		<div class="container">
			<div class="section__header reveal">
				<h2 class="section__title">{t("about.title")}</h2>
				<p class="section__subtitle">{t("about.subtitle")}</p>
			</div>
			<div class="section__grid">
				<div class="section__block reveal reveal--delay-1 hover-lift">
					<svg
						class="section__block-icon"
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<circle cx="12" cy="12" r="10"></circle>
						<circle cx="12" cy="12" r="6"></circle>
						<circle cx="12" cy="12" r="2"></circle>
					</svg>
					<h3 class="section__block-title">{t("about.mission.title")}</h3>
					<p class="section__block-text">{t("about.mission.text")}</p>
				</div>
				<div class="section__block reveal reveal--delay-2 hover-lift">
					<svg
						class="section__block-icon"
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"
						></path><circle cx="12" cy="12" r="3"></circle>
					</svg>
					<h3 class="section__block-title">{t("about.vision.title")}</h3>
					<p class="section__block-text">{t("about.vision.text")}</p>
				</div>
			</div>
			<div class="section__cta">
				<Button
					variant="secondary"
					size="lg"
					href={getLocalizedPath("/about", DEFAULT_LOCALE)}
				>
					{t("nav.about")}
				</Button>
			</div>
		</div>
	</section>

	<!-- CTA Contacto -->
	<section class="section section--gradient">
		<div class="container">
			<div class="section__header reveal">
				<h2 class="section__title">{t("contact.title")}</h2>
				<p class="section__subtitle">{t("contact.subtitle")}</p>
			</div>
			<div class="section__cta">
				<Button
					variant="warm"
					size="lg"
					href={getLocalizedPath("/contact", DEFAULT_LOCALE)}
				>
					{t("hero.cta_contact")}
				</Button>
			</div>
		</div>
	</section>
</MainLayout>
