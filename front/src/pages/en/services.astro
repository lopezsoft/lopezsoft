---
// ==========================================================================
// LOPEZSOFT SAS — Services Page (EN)
// ==========================================================================
import MainLayout from "@layouts/MainLayout.astro";
import ServiceCard from "@components/ServiceCard.astro";
import Button from "@components/Button.astro";
import { useTranslations, getLocalizedPath } from "@i18n/utils";

const t = useTranslations("en");

const services = [
  "custom_software",
  "consulting",
  "electronic_invoicing",
  "systems_implementation",
  "software_maintenance",
  "training",
];
---

<MainLayout title={`${t("services.title")} — LOPEZSOFT SAS`}>
  <section class="section">
    <div class="container">
      <div class="section__header reveal">
        <h1 class="section__title">{t("services.title")}</h1>
        <p class="section__subtitle">{t("services.subtitle")}</p>
      </div>
      <div class="services-grid">
        {
          services.map((key) => (
            <ServiceCard
              name={t(`services.${key}.name`)}
              description={t(`services.${key}.description`)}
              icon={t(`services.${key}.icon`)}
            />
          ))
        }
      </div>
      <div class="section__cta">
        <Button
          variant="warm"
          size="lg"
          href={getLocalizedPath("/contact", "en")}
        >
          {t("hero.cta_contact")}
        </Button>
      </div>
    </div>
  </section>
</MainLayout>
