---
// ==========================================================================
// LOPEZSOFT SAS — Services Page (EN)
// ==========================================================================
import MainLayout from "@layouts/MainLayout.astro";
import ServiceCard from "@components/ServiceCard.astro";
import Button from "@components/Button.astro";
import { useTranslations, getLocalizedPath } from "@i18n/utils";

const t = useTranslations("en");

const services = [
  "custom_software",
  "consulting",
  "electronic_invoicing",
  "systems_implementation",
  "software_maintenance",
  "training",
  "web_design",
  "ai_automation",
];

const stackCategories = [
  "frontend",
  "backend",
  "databases",
  "cloud",
  "mobile",
  "tools",
];
---

<MainLayout title={`${t("services.title")} — LOPEZSOFT SAS`}>
  <!-- Services hero -->
  <div class="hero-wrapper">
    <section class="hero">
      <h1 class="hero__title">{t("services.title")}</h1>
      <p class="hero__subtitle">{t("services.subtitle")}</p>
    </section>
  </div>

  <!-- Services grid -->
  <section class="section">
    <div class="container">
      <div class="services-grid">
        {
          services.map((key) => (
            <ServiceCard
              name={t(`services.${key}.name`)}
              description={t(`services.${key}.description`)}
              icon={t(`services.${key}.icon`)}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- Tech stack -->
  <section class="section section--alt">
    <div class="container">
      <div class="section__header reveal">
        <h2 class="section__title">{t("tech_stack.title")}</h2>
        <p class="section__subtitle">{t("tech_stack.subtitle")}</p>
      </div>
      <div class="tech-stack">
        {
          stackCategories.map((cat) => (
            <div class="tech-stack__category reveal">
              <h3 class="tech-stack__category-name">
                {t(`tech_stack.categories.${cat}.name`)}
              </h3>
              <div class="tech-stack__tags">
                {(t.raw(`tech_stack.categories.${cat}.items`) as string[]).map(
                  (item: string) => (
                    <span class="tech-stack__tag">{item}</span>
                  )
                )}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Contact CTA -->
  <section class="section section--gradient">
    <div class="container">
      <div class="section__header reveal">
        <h2 class="section__title">{t("home.cta_title")}</h2>
        <p class="section__subtitle">{t("home.cta_text")}</p>
      </div>
      <div class="section__cta">
        <Button
          variant="warm"
          size="lg"
          href={getLocalizedPath("/contact", "en")}
        >
          {t("hero.cta_contact")}
        </Button>
      </div>
    </div>
  </section>
</MainLayout>
