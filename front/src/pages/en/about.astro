---
// ==========================================================================
// LOPEZSOFT SAS — Página About (EN)
// ==========================================================================
import MainLayout from "@layouts/MainLayout.astro";
import { useTranslations } from "@i18n/utils";

const t = useTranslations("en");
---

<MainLayout title={`${t("about.title")} — LOPEZSOFT SAS`}>
  <section class="section">
    <div class="container">
      <div class="section__header">
        <h1 class="section__title">{t("about.title")}</h1>
        <p class="section__subtitle">{t("about.subtitle")}</p>
      </div>

      <div class="section__grid">
        <!-- Mission -->
        <div class="section__block">
          <svg class="section__block-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/>
            <circle cx="12" cy="12" r="6"/>
            <circle cx="12" cy="12" r="2"/>
          </svg>
          <h2 class="section__block-title">{t("about.mission.title")}</h2>
          <p class="section__block-text">{t("about.mission.text")}</p>
        </div>

        <!-- Vision -->
        <div class="section__block">
          <svg class="section__block-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/>
            <circle cx="12" cy="12" r="3"/>
          </svg>
          <h2 class="section__block-title">{t("about.vision.title")}</h2>
          <p class="section__block-text">{t("about.vision.text")}</p>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
