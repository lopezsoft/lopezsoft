---
// ==========================================================================
// LOPEZSOFT SAS — Página Nosotros (ES)
// ==========================================================================
import MainLayout from "@layouts/MainLayout.astro";
import Button from "@components/Button.astro";
import { useTranslations, getLocalizedPath } from "@i18n/utils";
import { DEFAULT_LOCALE } from "@i18n/config";

const t = useTranslations(DEFAULT_LOCALE);

const values = ["quality", "innovation", "commitment", "agility"];
const stats = ["experience", "projects", "technologies", "clients"];

const valueIcons: Record<string, string> = {
  shield:
    "M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z",
  sparkles:
    "M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z",
  heart:
    "M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z",
  bolt:
    "M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z",
};
---

<MainLayout title={`${t("about.title")} — LOPEZSOFT SAS`} description={t("seo.about.description")}>
  <!-- Hero -->
  <div class="hero-wrapper">
    <section class="hero">
      <h1 class="hero__title">{t("about.title")}</h1>
      <p class="hero__subtitle">{t("about.subtitle")}</p>
    </section>
  </div>

  <!-- Misión & Visión -->
  <section class="section">
    <div class="container">
      <div class="section__grid">
        <!-- Misión -->
        <div class="section__block reveal">
          <svg
            class="section__block-icon"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="10"></circle>
            <circle cx="12" cy="12" r="6"></circle>
            <circle cx="12" cy="12" r="2"></circle>
          </svg>
          <h2 class="section__block-title">{t("about.mission.title")}</h2>
          <p class="section__block-text">{t("about.mission.text")}</p>
        </div>

        <!-- Visión -->
        <div class="section__block reveal">
          <svg
            class="section__block-icon"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
            <circle cx="12" cy="12" r="3"></circle>
          </svg>
          <h2 class="section__block-title">{t("about.vision.title")}</h2>
          <p class="section__block-text">{t("about.vision.text")}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Estadísticas -->
  <section class="section section--alt">
    <div class="container">
      <div class="stats-bar">
        {
          stats.map((key) => (
            <div class="stats-bar__item reveal">
              <span class="stats-bar__value">{t(`about.stats.${key}.value`)}</span>
              <span class="stats-bar__label">{t(`about.stats.${key}.label`)}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Valores -->
  <section class="section">
    <div class="container">
      <div class="section__header reveal">
        <h2 class="section__title">{t("about.values_title")}</h2>
        <p class="section__subtitle">{t("about.values_subtitle")}</p>
      </div>
      <div class="section__grid section__grid--4">
        {
          values.map((key) => (
            <div class="section__block reveal">
              <svg
                class="section__block-icon"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={valueIcons[t(`about.values.${key}.icon`)]} />
              </svg>
              <h3 class="section__block-title">{t(`about.values.${key}.name`)}</h3>
              <p class="section__block-text">{t(`about.values.${key}.description`)}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--gradient">
    <div class="container">
      <div class="section__header reveal">
        <h2 class="section__title">{t("contact.title")}</h2>
        <p class="section__subtitle">{t("contact.subtitle")}</p>
      </div>
      <div class="section__cta">
        <Button
          variant="warm"
          size="lg"
          href={getLocalizedPath("/contact", DEFAULT_LOCALE)}
        >
          {t("hero.cta_contact")}
        </Button>
      </div>
    </div>
  </section>
</MainLayout>
