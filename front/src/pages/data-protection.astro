---
// ==========================================================================
// LOPEZSOFT SAS — Página Protección de Datos (ES)
// ==========================================================================
import MainLayout from "@layouts/MainLayout.astro";
import { useTranslations } from "@i18n/utils";
import { DEFAULT_LOCALE } from "@i18n/config";

const t = useTranslations(DEFAULT_LOCALE);
---

<MainLayout title={`${t("data_protection.title")} — LOPEZSOFT SAS`}>
  <!-- Hero -->
  <div class="hero-wrapper">
    <section class="hero">
      <h1 class="hero__title">{t("data_protection.title")}</h1>
      <p class="hero__subtitle">{t("data_protection.subtitle")}</p>
      <p class="hero__meta">{t("data_protection.last_updated")}</p>
    </section>
  </div>

  <!-- Content -->
  <section class="section">
    <div class="container">
      <div class="legal__content">
        <p class="legal__intro reveal">{t("data_protection.intro")}</p>

        <div class="legal__section reveal">
          <div class="legal__section-header">
            <span class="legal__section-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21" />
              </svg>
            </span>
            <h2>{t("data_protection.responsible.title")}</h2>
          </div>
          <p>{t("data_protection.responsible.text")}</p>
          <ul>
            <li>{t("data_protection.responsible.details.0")}</li>
            <li>{t("data_protection.responsible.details.1")}</li>
            <li>{t("data_protection.responsible.details.2")}</li>
            <li>{t("data_protection.responsible.details.3")}</li>
          </ul>
        </div>

        <div class="legal__section reveal">
          <div class="legal__section-header">
            <span class="legal__section-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 3v17.25m0 0c-1.472 0-2.882.265-4.185.75M12 20.25c1.472 0 2.882.265 4.185.75M18.75 4.97A48.416 48.416 0 0012 4.5c-2.291 0-4.545.16-6.75.47m13.5 0c1.01.143 2.01.317 3 .52m-3-.52l2.62 10.726c.122.499-.106 1.028-.589 1.202a5.988 5.988 0 01-2.031.352 5.988 5.988 0 01-2.031-.352c-.483-.174-.711-.703-.59-1.202L18.75 4.971zm-16.5.52c.99-.203 1.99-.377 3-.52m0 0l2.62 10.726c.122.499-.106 1.028-.589 1.202a5.989 5.989 0 01-2.031.352 5.989 5.989 0 01-2.031-.352c-.483-.174-.711-.703-.59-1.202L5.25 4.971z" />
              </svg>
            </span>
            <h2>{t("data_protection.principles.title")}</h2>
          </div>
          <p>{t("data_protection.principles.text")}</p>
          <ul>
            <li>{t("data_protection.principles.items.0")}</li>
            <li>{t("data_protection.principles.items.1")}</li>
            <li>{t("data_protection.principles.items.2")}</li>
            <li>{t("data_protection.principles.items.3")}</li>
            <li>{t("data_protection.principles.items.4")}</li>
            <li>{t("data_protection.principles.items.5")}</li>
            <li>{t("data_protection.principles.items.6")}</li>
          </ul>
        </div>

        <div class="legal__section reveal">
          <div class="legal__section-header">
            <span class="legal__section-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 010 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 010-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.281z" />
                <path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </span>
            <h2>{t("data_protection.treatment.title")}</h2>
          </div>
          <p>{t("data_protection.treatment.text")}</p>
          <ul>
            <li>{t("data_protection.treatment.items.0")}</li>
            <li>{t("data_protection.treatment.items.1")}</li>
            <li>{t("data_protection.treatment.items.2")}</li>
            <li>{t("data_protection.treatment.items.3")}</li>
            <li>{t("data_protection.treatment.items.4")}</li>
          </ul>
        </div>

        <div class="legal__section reveal">
          <div class="legal__section-header">
            <span class="legal__section-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
              </svg>
            </span>
            <h2>{t("data_protection.rights.title")}</h2>
          </div>
          <p>{t("data_protection.rights.text")}</p>
          <ul>
            <li>{t("data_protection.rights.items.0")}</li>
            <li>{t("data_protection.rights.items.1")}</li>
            <li>{t("data_protection.rights.items.2")}</li>
            <li>{t("data_protection.rights.items.3")}</li>
            <li>{t("data_protection.rights.items.4")}</li>
            <li>{t("data_protection.rights.items.5")}</li>
          </ul>
        </div>

        <div class="legal__section reveal">
          <div class="legal__section-header">
            <span class="legal__section-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
              </svg>
            </span>
            <h2>{t("data_protection.security.title")}</h2>
          </div>
          <p>{t("data_protection.security.text")}</p>
        </div>

        <div class="legal__section legal__section--highlight reveal">
          <div class="legal__section-header">
            <span class="legal__section-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
              </svg>
            </span>
            <h2>{t("data_protection.contact.title")}</h2>
          </div>
          <p>{t("data_protection.contact.text")}</p>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
