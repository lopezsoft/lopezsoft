---
// ==========================================================================
// LOPEZSOFT SAS — Página Política de Privacidad (ES)
// ==========================================================================
import MainLayout from "@layouts/MainLayout.astro";
import { useTranslations } from "@i18n/utils";
import { DEFAULT_LOCALE } from "@i18n/config";

const t = useTranslations(DEFAULT_LOCALE);
---

<MainLayout title={`${t("privacy.title")} — LOPEZSOFT SAS`}>
  <!-- Hero -->
  <div class="hero-wrapper">
    <section class="hero">
      <h1 class="hero__title">{t("privacy.title")}</h1>
      <p class="hero__subtitle">{t("privacy.subtitle")}</p>
      <p class="hero__meta">{t("privacy.last_updated")}</p>
    </section>
  </div>

  <!-- Content -->
  <section class="section">
    <div class="container">
      <div class="legal__content">
        <p class="legal__intro reveal">{t("privacy.intro")}</p>

        <div class="legal__section reveal">
          <div class="legal__section-header">
            <span class="legal__section-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" />
              </svg>
            </span>
            <h2>{t("privacy.collection.title")}</h2>
          </div>
          <p>{t("privacy.collection.text")}</p>
          <ul>
            <li>{t("privacy.collection.items.0")}</li>
            <li>{t("privacy.collection.items.1")}</li>
            <li>{t("privacy.collection.items.2")}</li>
            <li>{t("privacy.collection.items.3")}</li>
          </ul>
        </div>

        <div class="legal__section reveal">
          <div class="legal__section-header">
            <span class="legal__section-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 010 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 010-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.281z" />
                <path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </span>
            <h2>{t("privacy.use.title")}</h2>
          </div>
          <p>{t("privacy.use.text")}</p>
          <ul>
            <li>{t("privacy.use.items.0")}</li>
            <li>{t("privacy.use.items.1")}</li>
            <li>{t("privacy.use.items.2")}</li>
            <li>{t("privacy.use.items.3")}</li>
            <li>{t("privacy.use.items.4")}</li>
          </ul>
        </div>

        <div class="legal__section reveal">
          <div class="legal__section-header">
            <span class="legal__section-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" />
              </svg>
            </span>
            <h2>{t("privacy.cookies.title")}</h2>
          </div>
          <p>{t("privacy.cookies.text")}</p>
        </div>

        <div class="legal__section reveal">
          <div class="legal__section-header">
            <span class="legal__section-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
              </svg>
            </span>
            <h2>{t("privacy.rights.title")}</h2>
          </div>
          <p>{t("privacy.rights.text")}</p>
          <ul>
            <li>{t("privacy.rights.items.0")}</li>
            <li>{t("privacy.rights.items.1")}</li>
            <li>{t("privacy.rights.items.2")}</li>
            <li>{t("privacy.rights.items.3")}</li>
            <li>{t("privacy.rights.items.4")}</li>
          </ul>
        </div>

        <div class="legal__section legal__section--highlight reveal">
          <div class="legal__section-header">
            <span class="legal__section-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
              </svg>
            </span>
            <h2>{t("privacy.contact.title")}</h2>
          </div>
          <p>{t("privacy.contact.text")}</p>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
