---
// ==========================================================================
// LOPEZSOFT SAS — Página Contacto (ES)
// ==========================================================================
import MainLayout from "@layouts/MainLayout.astro";
import ContactForm from "@components/ContactForm.astro";
import { useTranslations } from "@i18n/utils";
import { DEFAULT_LOCALE } from "@i18n/config";

const t = useTranslations(DEFAULT_LOCALE);
---

<MainLayout title={`${t("contact.title")} — LOPEZSOFT SAS`}>
  <section class="section">
    <div class="container">
      <div class="section__header">
        <h1 class="section__title">{t("contact.title")}</h1>
        <p class="section__subtitle">{t("contact.subtitle")}</p>
      </div>
      <ContactForm lang={DEFAULT_LOCALE} />
    </div>
  </section>
</MainLayout>
